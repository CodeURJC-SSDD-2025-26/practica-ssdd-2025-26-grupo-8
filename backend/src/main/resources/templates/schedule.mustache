<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horarios - Virtus Fitness</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/schedule.css">
</head>
<body>
    {{> fragments/navbar}}

    <section class="schedule-hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1>Horario de Actividades</h1>
            <p>Entrenamiento de alto rendimiento · Lunes a Viernes · 09:00 – 21:00</p>
        </div>
    </section>

    <section class="schedule-page">
        <div class="container">
            <div class="schedule-wrapper table-responsive">
                <table class="schedule-table">
                    <thead>
                        <tr><th>Hora</th><th>Lunes</th><th>Martes</th><th>Miércoles</th><th>Jueves</th><th>Viernes</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="time-cell"><span class="time-range">09:00 – 11:00</span><span class="time-duration">2 horas</span></td>
                            <td><div class="activity-slot act-yoga"><span class="act-name">Yoga Flow</span><span class="act-room">Sala 1</span></div></td>
                            <td><div class="activity-slot act-crossfit"><span class="act-name">CrossFit WOD</span><span class="act-room">Box</span></div></td>
                            <td><div class="activity-slot act-yoga"><span class="act-name">Yoga Flow</span><span class="act-room">Sala 1</span></div></td>
                            <td><div class="activity-slot act-crossfit"><span class="act-name">CrossFit WOD</span><span class="act-room">Box</span></div></td>
                            <td><div class="activity-slot act-pilates"><span class="act-name">Pilates Reformer</span><span class="act-room">Sala 2</span></div></td>
                        </tr>
                        <tr>
                            <td class="time-cell"><span class="time-range">11:00 – 13:00</span><span class="time-duration">2 horas</span></td>
                            <td><div class="activity-slot act-cycling"><span class="act-name">Indoor Cycling</span><span class="act-room">Sala Spin</span></div></td>
                            <td><div class="activity-slot act-boxing"><span class="act-name">Boxing Pro</span><span class="act-room">Sala 2</span></div></td>
                            <td><div class="activity-slot act-cycling"><span class="act-name">Indoor Cycling</span><span class="act-room">Sala Spin</span></div></td>
                            <td><div class="activity-slot act-boxing"><span class="act-name">Boxing Pro</span><span class="act-room">Sala 2</span></div></td>
                            <td><div class="activity-slot act-zumba"><span class="act-name">Zumba Dance</span><span class="act-room">Sala 1</span></div></td>
                        </tr>
                        <tr>
                            <td class="time-cell"><span class="time-range">13:00 – 15:00</span><span class="time-duration">2 horas</span></td>
                            <td><div class="activity-slot act-crossfit"><span class="act-name">CrossFit WOD</span><span class="act-room">Box</span></div></td>
                            <td><div class="activity-slot act-pilates"><span class="act-name">Pilates Reformer</span><span class="act-room">Sala 2</span></div></td>
                            <td><div class="activity-slot act-crossfit"><span class="act-name">CrossFit WOD</span><span class="act-room">Box</span></div></td>
                            <td><div class="activity-slot act-pilates"><span class="act-name">Pilates Reformer</span><span class="act-room">Sala 2</span></div></td>
                            <td><div class="activity-slot act-cycling"><span class="act-name">Indoor Cycling</span><span class="act-room">Sala Spin</span></div></td>
                        </tr>
                        <tr>
                            <td class="time-cell"><span class="time-range">17:00 – 19:00</span><span class="time-duration">2 horas</span></td>
                            <td><div class="activity-slot act-yoga"><span class="act-name">Yoga Flow</span><span class="act-room">Sala 1</span></div></td>
                            <td><div class="activity-slot act-crossfit"><span class="act-name">CrossFit WOD</span><span class="act-room">Box</span></div></td>
                            <td><div class="activity-slot act-yoga"><span class="act-name">Yoga Flow</span><span class="act-room">Sala 1</span></div></td>
                            <td><div class="activity-slot act-crossfit"><span class="act-name">CrossFit WOD</span><span class="act-room">Box</span></div></td>
                            <td><div class="activity-slot act-pilates"><span class="act-name">Pilates Reformer</span><span class="act-room">Sala 2</span></div></td>
                        </tr>
                        <tr>
                            <td class="time-cell"><span class="time-range">19:00 – 21:00</span><span class="time-duration">2 horas</span></td>
                            <td><div class="activity-slot act-cycling"><span class="act-name">Indoor Cycling</span><span class="act-room">Sala Spin</span></div></td>
                            <td><div class="activity-slot act-boxing"><span class="act-name">Boxing Pro</span><span class="act-room">Sala 2</span></div></td>
                            <td><div class="activity-slot act-cycling"><span class="act-name">Indoor Cycling</span><span class="act-room">Sala Spin</span></div></td>
                            <td><div class="activity-slot act-boxing"><span class="act-name">Boxing Pro</span><span class="act-room">Sala 2</span></div></td>
                            <td><div class="activity-slot act-zumba"><span class="act-name">Zumba Dance</span><span class="act-room">Sala 1</span></div></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            {{#classes}}
            <div class="mt-5">
                <h3 class="section-title mb-4">Horarios de Clases</h3>
                <div class="row g-3">
                    {{#classes}}
                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 rounded" style="background:rgba(200,255,0,0.06);border:1px solid rgba(200,255,0,0.15);">
                            <h6 class="fw-bold text-warning mb-1">{{name}}</h6>
                            <p class="text-muted small mb-1">{{schedule}}</p>
                            <a href="/classes/{{id}}" class="btn btn-sm btn-outline-warning">Ver Clase</a>
                        </div>
                    </div>
                    {{/classes}}
                </div>
            </div>
            {{/classes}}

            <div class="schedule-info-box">
                <i class="bi bi-info-circle-fill info-icon"></i>
                <div>
                    <h5>Información de Reserva</h5>
                    <p>Todas las sesiones tienen una duración máxima de 90 minutos. Es obligatorio reservar a través de tu Perfil de Usuario.</p>
                </div>
            </div>
        </div>
    </section>

    {{> fragments/footer}}

    <button id="backToTop" class="btn btn-warning rounded-circle shadow" title="Volver arriba"><i class="bi bi-arrow-up"></i></button>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
