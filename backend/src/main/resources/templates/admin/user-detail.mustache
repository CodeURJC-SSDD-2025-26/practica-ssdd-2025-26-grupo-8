<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil de Usuario - Virtus Fitness Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-users.css">
</head>
<body>

    {{> fragments/navbar}}

    <div class="admin-page">
        <div class="admin-page-header">
            <div class="container">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                        <li class="breadcrumb-item"><a href="/admin/users">Usuarios</a></li>
                        <li class="breadcrumb-item active">{{user.username}}</li>
                    </ol>
                </nav>
                <h1><i class="bi bi-person-circle"></i> Perfil de Usuario</h1>
            </div>
        </div>

        <div class="container mt-4">

            {{#success}}
            <div class="alert alert-success alert-dismissible fade show">
                {{success}}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {{/success}}
            {{#error}}
            <div class="alert alert-danger alert-dismissible fade show">
                {{error}}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {{/error}}

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="card bg-dark text-white border-secondary h-100">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                {{#user.hasAvatar}}
                                <img src="/images/user/{{user.id}}"
                                     alt="Avatar"
                                     class="rounded-circle"
                                     style="width:100px;height:100px;object-fit:cover;border:3px solid #C8FF00;">
                                {{/user.hasAvatar}}
                                {{^user.hasAvatar}}
                                <div style="width:100px;height:100px;background:#2a2a2a;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2.5rem;color:#C8FF00;border:3px solid #C8FF00;margin:0 auto;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                {{/user.hasAvatar}}
                            </div>
                            <h4 class="fw-bold text-warning">{{user.username}}</h4>
                            <p class="text-muted mb-1"><i class="bi bi-envelope me-1"></i>{{user.email}}</p>

                            <span class="badge mt-2 {{user.roleBadgeClass}}">{{user.roleBadgeText}}</span>
                            <span class="badge bg-warning text-dark ms-1">{{user.planType}}</span>

                            <hr class="border-secondary my-3">

                            <div class="row text-center g-2">
                                <div class="col-6">
                                    <div style="background:rgba(200,255,0,0.08);border-radius:8px;padding:10px;">
                                        <h4 class="text-warning mb-0">{{confirmedCount}}</h4>
                                        <small class="text-muted">Reservas Activas</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div style="background:rgba(200,255,0,0.08);border-radius:8px;padding:10px;">
                                        <h4 class="text-warning mb-0">{{bookingsCount}}</h4>
                                        <small class="text-muted">Total Reservas</small>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 d-grid gap-2">
                                <a href="/admin/users" class="btn btn-outline-light btn-sm">
                                    <i class="bi bi-arrow-left me-1"></i> Volver a Usuarios
                                </a>
                                <form action="/admin/users/{{user.id}}/delete" method="post"
                                      onsubmit="return confirm('¿Eliminar este usuario?')">
                                    <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                        <i class="bi bi-trash me-1"></i> Eliminar Usuario
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="admin-container">
                        <div class="admin-toolbar">
                            <h2><i class="bi bi-calendar-check"></i> Historial de Reservas</h2>
                        </div>

                        {{^bookings}}
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-3"></i>
                            <p class="mt-2">Este usuario no tiene reservas aún.</p>
                        </div>
                        {{/bookings}}

                        {{#bookings}}
                        <div style="overflow-x:auto;">
                            <table class="users-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Clase</th>
                                        <th>Instructor</th>
                                        <th>Fecha</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#bookings}}
                                    <tr>
                                        <td>{{id}}</td>
                                        <td>
                                            <a href="/classes/{{fitnessClass.id}}"
                                               class="text-warning text-decoration-none fw-bold">{{fitnessClass.name}}</a>
                                        </td>
                                        <td>{{fitnessClass.instructor}}</td>
                                        <td>{{formattedDate}}</td>
                                        <td>
                                            <span class="role-badge {{adminStatusClass}}" style="{{adminStatusStyle}}">
                                                {{adminStatusText}}
                                            </span>
                                        </td>
                                    </tr>
                                    {{/bookings}}
                                </tbody>
                            </table>
                        </div>
                        <div class="table-footer">
                            <p>Mostrando {{bookingsCount}} reservas</p>
                        </div>
                        {{/bookings}}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
