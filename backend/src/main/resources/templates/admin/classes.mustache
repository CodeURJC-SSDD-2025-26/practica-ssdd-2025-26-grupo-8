<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administración de Clases - Virtus Fitness</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin-classes.css">
</head>
<body>

    <div class="admin-header">
        <div class="container">
            <a href="/admin" class="back-button">
                <i class="bi bi-arrow-left-circle"></i> Volver al Panel
            </a>
            <h1><i class="bi bi-speedometer2"></i> Panel de Administración</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                    <li class="breadcrumb-item active">Gestión de Clases</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container">

        {{#success}}
        <div class="alert alert-success alert-dismissible fade show mt-3">
            <i class="bi bi-check-circle me-2"></i>{{success}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {{/success}}
        {{#error}}
        <div class="alert alert-danger alert-dismissible fade show mt-3">
            <i class="bi bi-exclamation-triangle me-2"></i>{{error}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {{/error}}

        <div class="stats-cards">
            <div class="stat-card total">
                <div class="stat-card-icon"><i class="bi bi-calendar-check"></i></div>
                <div class="stat-card-info"><p>Total de Clases</p><h3>{{totalClasses}}</h3></div>
            </div>
            <div class="stat-card active">
                <div class="stat-card-icon"><i class="bi bi-check-circle"></i></div>
                <div class="stat-card-info"><p>Clases Activas</p><h3>{{activeClasses}}</h3></div>
            </div>
        </div>

        <div class="admin-container">
            <div class="admin-toolbar">
                <h2><i class="bi bi-list-check"></i> Gestión de Clases</h2>
                <div class="d-flex gap-2 align-items-center">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" class="form-control" placeholder="Buscar clases..." id="searchInput"
                               oninput="filterClasses()">
                    </div>
                    <a href="/admin/classes/new" class="btn-add-class">
                        <i class="bi bi-plus-circle"></i> Añadir Nueva Clase
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table admin-table" id="classesTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>Instructor</th>
                            <th>Horario</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#classes}}
                        <tr>
                            <td class="class-id">#{{id}}</td>
                            <td>
                                <img src="/images/class/{{id}}"
                                     alt="img" style="width:50px;height:40px;object-fit:cover;border-radius:4px;"
                                     onerror="this.style.display='none'">
                            </td>
                            <td>
                                <div class="class-name">
                                    <span>{{name}}</span>
                                    <small class="text-muted d-block">{{difficulty}}</small>
                                </div>
                            </td>
                            <td>
                                <div class="instructor-info">
                                    <div class="instructor-avatar">{{instructorInitials}}</div>
                                    <span class="instructor-name">{{instructor}}</span>
                                </div>
                            </td>
                            <td>
                                {{#hasSchedule}}
                                <span class="schedule-badge">
                                    <i class="bi bi-clock"></i> {{schedule}}
                                </span>
                                {{/hasSchedule}}
                                {{^hasSchedule}}<span class="text-muted">-</span>{{/hasSchedule}}
                            </td>
                            <td>
                                {{#active}}<span class="badge bg-success">Activa</span>{{/active}}
                                {{^active}}<span class="badge bg-secondary">Inactiva</span>{{/active}}
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="/admin/classes/{{id}}/edit" class="btn-action btn-edit">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <form action="/admin/classes/{{id}}/delete" method="post"
                                          onsubmit="return confirm('¿Eliminar esta clase?')">
                                        <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                                        <button type="submit" class="btn-action btn-delete">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{/classes}}
                    </tbody>
                </table>
            </div>

            {{^classes}}
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x fs-3"></i>
                <p class="mt-2">No hay clases creadas todavía.</p>
                <a href="/admin/classes/new" class="btn btn-warning">Crear Primera Clase</a>
            </div>
            {{/classes}}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function filterClasses() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#classesTable tbody tr');
            rows.forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(query) ? '' : 'none';
            });
        }
    </script>
</body>
</html>
