<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración - Virtus Fitness</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <div class="admin-dashboard">

        <div class="admin-page-header">
            <div class="container">
                <a href="/" class="back-button">
                    <i class="bi bi-arrow-left-circle"></i> Volver al Inicio
                </a>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                        <li class="breadcrumb-item active">Administración</li>
                    </ol>
                </nav>
                <h1><i class="bi bi-speedometer2"></i> Panel de Administración</h1>
                <p>Selecciona el área que deseas gestionar</p>
            </div>
        </div>

        <div class="container">

            {{#success}}
            <div class="alert alert-success alert-dismissible fade show mt-3">
                {{success}}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {{/success}}

            <div class="admin-content">

                <div class="admin-panels">

                    <a href="/admin/classes" class="panel-card">
                        <div class="panel-card-hero">
                            <div class="panel-card-icon"><i class="bi bi-calendar-check"></i></div>
                            <div class="panel-card-text">
                                <h2>Gestión de Clases</h2>
                                <p>Añade, edita y elimina clases. Gestiona horarios, instructores y capacidades.</p>
                            </div>
                        </div>
                        <div class="panel-card-stats">
                            <div class="panel-stat">
                                <strong>{{totalClasses}}</strong><span>Clases</span>
                            </div>
                            <div class="panel-stat">
                                <strong>{{activeClasses}}</strong><span>Activas</span>
                            </div>
                        </div>
                        <div class="panel-card-footer">
                            <span>Gestionar clases</span>
                            <i class="bi bi-arrow-right"></i>
                        </div>
                    </a>

                    <a href="/admin/users" class="panel-card">
                        <div class="panel-card-hero">
                            <div class="panel-card-icon"><i class="bi bi-people-fill"></i></div>
                            <div class="panel-card-text">
                                <h2>Gestión de Usuarios</h2>
                                <p>Consulta y administra los usuarios registrados, roles y estados de cuenta.</p>
                            </div>
                        </div>
                        <div class="panel-card-stats">
                            <div class="panel-stat">
                                <strong>{{totalUsers}}</strong><span>Usuarios</span>
                            </div>
                        </div>
                        <div class="panel-card-footer">
                            <span>Gestionar usuarios</span>
                            <i class="bi bi-arrow-right"></i>
                        </div>
                    </a>
                </div>

                <div class="chart-card">
                    <div class="chart-card-header">
                        <div>
                            <h3><i class="bi bi-graph-up-arrow"></i> Estadísticas del Sistema</h3>
                            <p>Resumen de la plataforma</p>
                        </div>
                    </div>
                    <div class="p-4">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="text-center p-3" style="background:rgba(200,255,0,0.08);border-radius:8px;">
                                    <h2 class="text-warning mb-1">{{totalClasses}}</h2>
                                    <small class="text-muted">Total Clases</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center p-3" style="background:rgba(200,255,0,0.08);border-radius:8px;">
                                    <h2 class="text-warning mb-1">{{activeClasses}}</h2>
                                    <small class="text-muted">Clases Activas</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center p-3" style="background:rgba(200,255,0,0.08);border-radius:8px;">
                                    <h2 class="text-warning mb-1">{{totalUsers}}</h2>
                                    <small class="text-muted">Usuarios Registrados</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center p-3" style="background:rgba(200,255,0,0.08);border-radius:8px;">
                                    <h2 class="text-warning mb-1">HTTPS</h2>
                                    <small class="text-muted">Conexión Segura</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
