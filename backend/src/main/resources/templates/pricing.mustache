<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Precios - Virtus Fitness</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/pricing.css">
</head>
<body>
    {{> fragments/navbar}}

    <section class="page-hero mt-5">
        <div class="hero-overlay"></div>
        <div class="hero-content animate-fade-in">
            <h1 class="display-4 fw-bold mb-2">Planes y Precios</h1>
            <p class="lead mb-0">Sin letra pequeña. Elige la cuota que mejor se adapte a ti.</p>
        </div>
    </section>

    <section class="pricing-section py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">Elige Tu Plan</h2>
                <p class="text-muted mt-4">Precios adaptados a tu situación personal</p>
            </div>
            <div class="row g-4 justify-content-center align-items-stretch">

                <!-- Básico -->
                <div class="col-md-4">
                    <div class="pricing-card">
                        <div class="pricing-header plan-basic">
                            <p class="plan-name">Plan Básico</p>
                            <p class="plan-tagline">Lo esencial para empezar</p>
                            <div class="price-display"><span class="price-currency">€</span><span class="price-amount">29</span><span class="price-cents">,90</span></div>
                            <p class="price-period">/mes · IVA incluido</p>
                        </div>
                        <div class="pricing-body">
                            <ul class="feature-list">
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> Acceso sala de fitness</li>
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> Vestuarios y duchas</li>
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> 2 clases grupales / semana</li>
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> App Virtus Fitness</li>
                                <li class="disabled"><i class="bi bi-x-circle-fill feat-no"></i> Entrenamiento personal</li>
                                <li class="disabled"><i class="bi bi-x-circle-fill feat-no"></i> Zona spa y sauna</li>
                            </ul>
                            {{^isAuthenticated}}<a href="/register" class="btn btn-outline-dark w-100">Elegir Plan Básico</a>{{/isAuthenticated}}
                            {{#isAuthenticated}}<a href="/profile" class="btn btn-outline-dark w-100">Mi Perfil</a>{{/isAuthenticated}}
                        </div>
                    </div>
                </div>

                <!-- Premium -->
                <div class="col-md-4">
                    <div class="pricing-card featured">
                        <div class="pricing-header plan-premium">
                            <span class="popular-badge">Más popular</span>
                            <p class="plan-name">Plan Premium</p>
                            <p class="plan-tagline">El favorito de nuestros socios</p>
                            <div class="price-display"><span class="price-currency">€</span><span class="price-amount">49</span><span class="price-cents">,90</span></div>
                            <p class="price-period">/mes · IVA incluido</p>
                        </div>
                        <div class="pricing-body">
                            <ul class="feature-list">
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> Acceso sala de fitness</li>
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> Clases grupales ilimitadas</li>
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> 2 sesiones / mes entrenador personal</li>
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> Zona spa y sauna</li>
                                <li class="disabled"><i class="bi bi-x-circle-fill feat-no"></i> Asesoramiento nutricional</li>
                            </ul>
                            {{^isAuthenticated}}<a href="/register" class="btn btn-warning w-100">Elegir Plan Premium</a>{{/isAuthenticated}}
                            {{#isAuthenticated}}<a href="/profile" class="btn btn-warning w-100">Mi Perfil</a>{{/isAuthenticated}}
                        </div>
                    </div>
                </div>

                <!-- Elite -->
                <div class="col-md-4">
                    <div class="pricing-card">
                        <div class="pricing-header plan-elite">
                            <p class="plan-name">Plan Elite</p>
                            <p class="plan-tagline">La experiencia fitness completa</p>
                            <div class="price-display"><span class="price-currency">€</span><span class="price-amount">79</span><span class="price-cents">,90</span></div>
                            <p class="price-period">/mes · IVA incluido</p>
                        </div>
                        <div class="pricing-body">
                            <ul class="feature-list">
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> Todo el Plan Premium</li>
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> Entrenador personal ilimitado</li>
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> Asesoramiento nutricional</li>
                                <li><i class="bi bi-check-circle-fill feat-yes"></i> App Virtus Fitness (premium)</li>
                            </ul>
                            {{^isAuthenticated}}<a href="/register" class="btn btn-dark w-100">Elegir Plan Elite</a>{{/isAuthenticated}}
                            {{#isAuthenticated}}<a href="/profile" class="btn btn-dark w-100">Mi Perfil</a>{{/isAuthenticated}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="newsletter-section py-5 text-center text-white">
        <div class="container">
            <h3 class="fw-bold mb-2">¿Tienes dudas sobre qué plan elegir?</h3>
            <p class="mb-4">Nuestro equipo te asesora sin compromiso.</p>
            <a href="/contact" class="btn btn-warning btn-lg fw-semibold px-5 me-2">Contactar</a>
            {{^isAuthenticated}}<a href="/register" class="btn btn-dark btn-lg px-5">Registrarme</a>{{/isAuthenticated}}
        </div>
    </section>

    {{> fragments/footer}}

    <button id="backToTop" class="btn btn-warning rounded-circle shadow" title="Volver arriba"><i class="bi bi-arrow-up"></i></button>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
