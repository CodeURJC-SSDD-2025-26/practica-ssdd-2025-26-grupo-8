<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Perfil - Virtus Fitness</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/profile.css">
</head>
<body>
    {{> fragments/navbar}}

    <div class="profile-page">
        <div class="container-fluid px-4">
            <a href="/" class="back-button"><i class="bi bi-arrow-left-circle"></i> Volver al Inicio</a>

            <div class="profile-container">
                <aside class="profile-sidebar">
                    <div class="profile-avatar-container">
                        <div class="profile-avatar">
                            {{#user.hasAvatar}}
                            <img src="/images/user/{{user.id}}" alt="Avatar" id="avatarImg"
                                 onerror="this.style.display='none'; document.getElementById('avatarPlaceholder').style.display='flex'">
                            {{/user.hasAvatar}}
                            {{^user.hasAvatar}}
                            <div id="avatarPlaceholder" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#2a2a2a;border-radius:50%;font-size:3rem;color:#C8FF00;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            {{/user.hasAvatar}}
                        </div>
                    </div>
                    <h2 class="profile-name">{{user.username}}</h2>
                    <p class="profile-email"><i class="bi bi-envelope"></i> {{user.email}}</p>
                    <span class="profile-plan-badge"><i class="bi bi-star-fill"></i> Plan {{user.planType}}</span>
                    <div class="profile-stats">
                        <div class="stat-item">
                            <span class="stat-label"><i class="bi bi-calendar-check"></i> Reservas Activas</span>
                            <span class="stat-value">{{completedCount}}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label"><i class="bi bi-list-check"></i> Total Reservas</span>
                            <span class="stat-value">{{bookingsCount}}</span>
                        </div>
                    </div>
                    <div class="profile-actions">
                        <a href="/classes" class="btn btn-warning"><i class="bi bi-calendar-plus me-1"></i> Reservar Clase</a>
                        <form action="/logout" method="post">
                            <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                            <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión</button>
                        </form>
                    </div>
                </aside>

                <main class="profile-content">
                    <div class="profile-header">
                        <h1><i class="bi bi-person-circle"></i> Mi Perfil</h1>
                        <p>Gestiona tu información personal y tus actividades</p>
                    </div>

                    {{#success}}<div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>{{success}}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{{/success}}
                    {{#error}}<div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>{{error}}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{{/error}}

                    <ul class="nav nav-tabs" id="profileTabs">
                        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#data"><i class="bi bi-person-lines-fill me-2"></i>Mis Datos</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#reservations"><i class="bi bi-calendar-event me-2"></i>Mis Reservas</button></li>
                    </ul>

                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="data">
                            <h3><i class="bi bi-pencil-square"></i> Editar Información Personal</h3>
                            <form action="/profile/edit" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label>Nombre de usuario</label>
                                        <input type="text" class="form-control" name="username" value="{{user.username}}" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label>Email</label>
                                        <input type="email" class="form-control" name="email" value="{{user.email}}" required>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label>Plan</label>
                                        <select class="form-select" name="planType">
                                            <option value="Básico" {{#user.planBasico}}selected{{/user.planBasico}}>Básico</option>
                                            <option value="Premium" {{#user.planPremium}}selected{{/user.planPremium}}>Premium</option>
                                            <option value="Elite" {{#user.planElite}}selected{{/user.planElite}}>Elite</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label>Foto de perfil</label>
                                        <input type="file" class="form-control" name="avatar" accept="image/*">
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-warning px-4 py-2 fw-bold"><i class="bi bi-check-circle me-2"></i>Guardar Cambios</button>
                            </form>
                        </div>

                        <div class="tab-pane fade" id="reservations">
                            <h3><i class="bi bi-calendar-check"></i> Mis Clases Reservadas</h3>

                            {{^bookings}}
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-calendar-x fs-3"></i>
                                <p class="mt-2">No tienes reservas aún.</p>
                                <a href="/classes" class="btn btn-warning">Ver Clases Disponibles</a>
                            </div>
                            {{/bookings}}

                            {{#bookings}}
                            <div class="reservations-table">
                                <table class="table table-borderless mb-0">
                                    <thead><tr><th>Clase</th><th>Instructor</th><th>Horario</th><th>Estado</th><th>Acciones</th></tr></thead>
                                    <tbody>
                                        {{#bookings}}
                                        <tr>
                                            <td><a href="/classes/{{fitnessClass.id}}" class="fw-bold text-warning text-decoration-none">{{fitnessClass.name}}</a></td>
                                            <td>{{fitnessClass.instructor}}</td>
                                            <td>{{fitnessClass.schedule}}</td>
                                            <td><span class="{{profileStatusClass}}">{{profileStatusText}}</span></td>
                                            <td>
                                                <div class="d-flex gap-1 flex-wrap">
                                                    {{#cancellable}}
                                                    <form action="/bookings/{{id}}/cancel" method="post">
                                                        <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Cancelar esta reserva?')"><i class="bi bi-x-circle"></i> Cancel</button>
                                                    </form>
                                                    {{/cancellable}}
                                                    {{#confirmedStatus}}
                                                    <a href="/bookings/{{id}}/pdf" class="btn btn-sm btn-outline-secondary" title="Download PDF"><i class="bi bi-file-pdf"></i> PDF</a>
                                                    {{/confirmedStatus}}
                                                </div>
                                            </td>
                                        </tr>
                                        {{/bookings}}
                                    </tbody>
                                </table>
                            </div>
                            {{/bookings}}

                            <div class="mt-4">
                                <a href="/classes" class="btn btn-warning fw-bold"><i class="bi bi-plus-circle me-1"></i>Reservar Más Clases</a>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>

    {{> fragments/footer}}

    <button id="backToTop" class="btn btn-warning rounded-circle shadow" title="Volver arriba"><i class="bi bi-arrow-up"></i></button>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
