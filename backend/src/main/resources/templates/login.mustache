<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - Virtus Fitness</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/auth-styles.css">
</head>
<body>
<div class="auth-page">
    <div class="auth-brand-panel">
        <div class="brand-overlay"></div>
        <div class="brand-content">
            <a href="/" class="back-to-home"><i class="bi bi-arrow-left"></i> Volver al inicio</a>
            <div class="brand-center">
                <div class="brand-logo"><i class="bi bi-lightning-charge-fill"></i></div>
                <h1 class="brand-name">Virtus Fitness</h1>
                <p class="brand-tagline">Transforma tu cuerpo y mente con los mejores profesionales</p>
            </div>
            <div class="brand-stats">
                <div class="brand-stat"><strong>1879+</strong><span>Miembros</span></div>
                <div class="brand-stat-divider"></div>
                <div class="brand-stat"><strong>25</strong><span>Entrenadores</span></div>
                <div class="brand-stat-divider"></div>
                <div class="brand-stat"><strong>16</strong><span>Años</span></div>
            </div>
        </div>
    </div>

    <div class="auth-form-panel">
        <div class="form-panel-inner">
            <div class="form-header">
                <h2>Bienvenido de nuevo</h2>
                <p>Introduce tus credenciales para acceder a tu cuenta</p>
            </div>

            {{#success}}<div class="alert alert-success">{{success}}</div>{{/success}}
            {{#loginError}}
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Email o contraseña incorrectos. Por favor, inténtalo de nuevo.
            </div>
            {{/loginError}}

            <form action="/login" method="post">
                <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                <div class="field-group">
                    <label for="email">Correo electrónico</label>
                    <div class="field-input-wrapper">
                        <i class="bi bi-envelope field-icon"></i>
                        <input type="email" id="email" name="email" placeholder="correo@ejemplo.com" required>
                    </div>
                </div>
                <div class="field-group">
                    <label for="password">Contraseña</label>
                    <div class="field-input-wrapper">
                        <i class="bi bi-lock field-icon"></i>
                        <input type="password" id="password" name="password" placeholder="Tu contraseña" required>
                    </div>
                </div>
                <button type="submit" class="btn-auth">Iniciar Sesión <i class="bi bi-arrow-right ms-2"></i></button>
            </form>

            <p class="auth-switch-link">¿No tienes cuenta? <a href="/register">Regístrate gratis</a></p>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
