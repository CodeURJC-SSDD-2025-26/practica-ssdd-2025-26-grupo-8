<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{fitnessClass.name}} - Virtus Fitness</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/boxeo.css">
</head>
<body>
    {{> fragments/navbar}}

    <section class="boxeo-hero mt-5" aria-label="Hero clase">
        <div class="hero-overlay"></div>
        <div class="hero-content animate-fade-in">
            <span class="level-pill mb-3 d-inline-block">{{fitnessClass.difficulty}}</span>
            <h1 class="display-3 fw-bold mb-3">{{fitnessClass.name}}</h1>
            <p class="lead mb-4 animate-fade-in-delay">{{fitnessClass.description}}</p>
            <div class="hero-buttons animate-fade-in-delay-2">
                {{#isAuthenticated}}
                {{^hasBooking}}
                <form action="/classes/{{fitnessClass.id}}/book" method="post" class="d-inline">
                    <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                    <button type="submit" class="btn btn-warning btn-lg me-2">Inscribirme Ahora</button>
                </form>
                {{/hasBooking}}
                {{#hasBooking}}
                <span class="btn btn-success btn-lg me-2 disabled"><i class="bi bi-check-circle me-1"></i>Ya tienes reserva</span>
                {{/hasBooking}}
                {{/isAuthenticated}}
                {{^isAuthenticated}}
                <a href="/login" class="btn btn-warning btn-lg me-2">Inscribirme</a>
                {{/isAuthenticated}}
                <a href="/schedule" class="btn btn-outline-light btn-lg">Ver Horarios</a>
            </div>
        </div>
    </section>

    <section class="breadcrumb-section py-2">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="/classes">Clases</a></li>
                    <li class="breadcrumb-item active">{{fitnessClass.name}}</li>
                </ol>
            </nav>
        </div>
    </section>

    <div class="container mt-3">
        {{#success}}<div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>{{success}}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{{/success}}
        {{#error}}<div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>{{error}}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{{/error}}
    </div>

    <section class="info-strip">
        <div class="container">
            <div class="row row-cols-2 row-cols-md-4 g-0">
                <div class="col border-end border-secondary"><div class="info-item px-3"><i class="bi bi-clock"></i><div><span class="info-label">Duración</span><span class="info-value">{{fitnessClass.duration}} minutos</span></div></div></div>
                <div class="col border-end border-secondary"><div class="info-item px-3"><i class="bi bi-people"></i><div><span class="info-label">Plazas disponibles</span><span class="info-value">{{availableSpots}} / {{fitnessClass.capacity}}</span></div></div></div>
                <div class="col border-end border-secondary"><div class="info-item px-3"><i class="bi bi-bar-chart-steps"></i><div><span class="info-label">Nivel</span><span class="info-value">{{fitnessClass.difficulty}}</span></div></div></div>
                <div class="col"><div class="info-item px-3"><i class="bi bi-currency-euro"></i><div><span class="info-label">Precio/sesión</span><span class="info-value">{{fitnessClass.price}}€</span></div></div></div>
            </div>
        </div>
    </section>

    <section class="class-description-section py-5">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h2 class="section-title mb-4">Sobre la Clase</h2>
                    <p class="lead mt-4">{{fitnessClass.description}}</p>
                    {{#fitnessClass.hasSchedule}}
                    <p class="text-muted mt-3"><i class="bi bi-calendar3 me-2 text-warning"></i><strong>Horario:</strong> {{fitnessClass.schedule}}</p>
                    {{/fitnessClass.hasSchedule}}
                    {{#fitnessClass.hasInstructor}}
                    <p class="text-muted"><i class="bi bi-person-badge me-2 text-warning"></i><strong>Instructor:</strong> {{fitnessClass.instructor}}</p>
                    {{/fitnessClass.hasInstructor}}
                </div>
                <div class="col-lg-6">
                    <div style="border-radius:10px;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,0.15);">
                        <img src="/images/class/{{fitnessClass.id}}" alt="{{fitnessClass.name}}" class="img-fluid d-block">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="reviews-section py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">Lo que dicen nuestros alumnos</h2>
                <p class="text-muted mt-4">Opiniones reales de personas que entrenan con nosotros</p>
            </div>

            {{#reviewCount}}
            <div class="rating-summary mb-5">
                <div class="rating-score">
                    <span class="score-number">{{avgRating}}</span>
                    <div class="score-stars"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i></div>
                    <span class="score-label">Basado en {{reviewCount}} reseñas</span>
                </div>
            </div>
            {{/reviewCount}}

            {{#reviews}}
            <div class="reviews-grid">
                <div class="review-card">
                    <div class="review-header">
                        <div class="review-avatar">{{userInitials}}</div>
                        <div class="review-meta">
                            <span class="review-author">{{user.username}}</span>
                            <span class="review-date">{{formattedDate}}</span>
                        </div>
                        <div class="review-stars">
                            {{#stars}}<i class="{{starClass}}"></i>{{/stars}}
                        </div>
                    </div>
                    <p class="review-text">{{comment}}</p>
                    {{#canDelete}}
                    <form action="/reviews/{{id}}/delete" method="post" class="mt-2">
                        <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                        <input type="hidden" name="classId" value="{{fitnessClass.id}}">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</button>
                    </form>
                    {{/canDelete}}
                </div>
            </div>
            {{/reviews}}
            {{^reviews}}
            <div class="text-center py-4 text-muted">
                <i class="bi bi-chat-square fs-3"></i>
                <p class="mt-2">Sé el primero en dejar una reseña para esta clase.</p>
            </div>
            {{/reviews}}

            {{#isAuthenticated}}
            <div class="review-form-wrapper mt-5">
                <h4 class="review-form-title"><i class="bi bi-pencil-square"></i> Deja tu reseña</h4>
                <form action="/classes/{{fitnessClass.id}}/reviews" method="post">
                    <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                    <div class="review-form-grid">
                        <div class="form-group">
                            <label>Valoración</label>
                            <select name="rating" class="form-select" required>
                                <option value="5">⭐⭐⭐⭐⭐ - Excelente</option>
                                <option value="4">⭐⭐⭐⭐ - Muy bueno</option>
                                <option value="3">⭐⭐⭐ - Bueno</option>
                                <option value="2">⭐⭐ - Regular</option>
                                <option value="1">⭐ - Malo</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group mt-3">
                        <label>Comentario</label>
                        <textarea name="comment" placeholder="Cuéntanos tu experiencia..." rows="3" required class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-warning mt-3"><i class="bi bi-send"></i> Publicar reseña</button>
                </form>
            </div>
            {{/isAuthenticated}}
            {{^isAuthenticated}}
            <div class="mt-4 text-center">
                <a href="/login" class="btn btn-outline-warning"><i class="bi bi-person me-1"></i>Inicia sesión para dejar una reseña</a>
            </div>
            {{/isAuthenticated}}
        </div>
    </section>

    <section class="cta-section py-5 text-center text-white">
        <div class="container">
            <h2 class="fw-bold mb-3">¿Preparado para empezar?</h2>
            <p class="lead mb-4">Regístrate ahora y consigue tu primera semana totalmente gratis.</p>
            <div class="hero-buttons">
                {{^isAuthenticated}}<a href="/register" class="btn btn-warning btn-lg me-2 fw-semibold">Inscribirme</a>{{/isAuthenticated}}
                <a href="/classes" class="btn btn-outline-light btn-lg">Ver Más Clases</a>
            </div>
        </div>
    </section>

    {{> fragments/footer}}

    <button id="backToTop" class="btn btn-warning rounded-circle shadow" title="Volver arriba"><i class="bi bi-arrow-up"></i></button>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
